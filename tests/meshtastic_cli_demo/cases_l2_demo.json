            "lora.override_frequency|override_frequency|frequency|Connected|\\d+",
            "device.role|role|CLIENT|TRACKER|ROUTER|MUTE"
          ],
          "action_summary": "\u6279\u91cf\u8bfb\u53d6\u6d4b\u8bd5\u8bbe\u59072\u901a\u4fe1\u5173\u952e\u914d\u7f6e"
        },
        {
          "name": "\u8bfb\u53d6\u6d4b\u8bd5\u8bbe\u59071\u9891\u90530",
          "target": "primary",
          "command": [
            "--ch-index",
            "0",
            "--info"
          ],
          "requires_connection": true,
          "mutating": false,
          "sensitive_output": true,
          "pass_criteria": "\u6d4b\u8bd5\u8bbe\u59071\u53ef\u8bfb\u53d6\u9891\u9053 0 \u4fe1\u606f\uff1b\u9875\u9762\u9690\u85cf\u53ef\u80fd\u5305\u542b\u7684 PSK/URL\u3002",
          "expect_stdout_regex_any": [
            "Channel|channels|name|psk|url|Complete|Connected"
          ],
          "action_summary": "\u8bfb\u53d6\u6d4b\u8bd5\u8bbe\u59071\u9891\u9053 0 \u5feb\u7167"
        },
        {
          "name": "\u8bfb\u53d6\u6d4b\u8bd5\u8bbe\u59072\u9891\u90530",
          "target": "peer",
          "command": [
            "--ch-index",
            "0",
            "--info"
          ],
          "requires_connection": true,
          "requires_peer": true,
          "mutating": false,
          "sensitive_output": true,
          "pass_criteria": "\u6d4b\u8bd5\u8bbe\u59072\u53ef\u8bfb\u53d6\u9891\u9053 0 \u4fe1\u606f\uff1b\u9875\u9762\u9690\u85cf\u53ef\u80fd\u5305\u542b\u7684 PSK/URL\u3002",
          "expect_stdout_regex_any": [
            "Channel|channels|name|psk|url|Complete|Connected"
          ],
          "action_summary": "\u8bfb\u53d6\u6d4b\u8bd5\u8bbe\u59072\u9891\u9053 0 \u5feb\u7167"
        },
        {
          "name": "\u6d4b\u8bd5\u8bbe\u59071\u8282\u70b9\u5217\u8868\u5305\u542b\u6d4b\u8bd5\u8bbe\u59072",
          "target": "primary",
          "command": [
            "--info"
          ],
          "requires_connection": true,
          "requires_peer": true,
          "expect_node_from": "peer_node_id",
          "mutating": false,
          "pass_criteria": "\u6d4b\u8bd5\u8bbe\u59071\u8282\u70b9\u5217\u8868\u4e2d\u51fa\u73b0\u6d4b\u8bd5\u8bbe\u59072\u8282\u70b9 ID\uff1b\u8fd9\u53ea\u8bc1\u660e\u8282\u70b9\u53ef\u89c1\uff0c\u4e0d\u7b49\u4ef7\u4e8e\u70b9\u5bf9\u70b9 ACK\u3002 \u5982\u679c CLI \u8f93\u51fa\u5305\u542b publicKey\uff0c\u9875\u9762\u4f1a\u63d0\u53d6\u5e76\u663e\u793a\u5bf9\u5e94\u8282\u70b9\u516c\u94a5\u3002 \u00e5\u008e\u009f\u00e5\u00a7\u008b\u00e9\u0085\u008d\u00e7\u00bd\u00ae\u00e8\u00be\u0093\u00e5\u0087\u00ba\u00e4\u00bc\u009a\u00e8\u0084\u00b1\u00e6\u0095\u008f\u00ef\u00bc\u008c\u00e9\u00a1\u00b5\u00e9\u009d\u00a2\u00e5\u008f\u00aa\u00e5\u00b1\u0095\u00e7\u00a4\u00ba\u00e8\u008a\u0082\u00e7\u0082\u00b9\u00e5\u0085\u00ac\u00e9\u0092\u00a5\u00e7\u00ad\u0089\u00e7\u00bb\u0093\u00e6\u009e\u0084\u00e5\u008c\u0096\u00e8\u00af\u0081\u00e6\u008d\u00ae\u00e3\u0080\u0082",
          "expect_stdout_regex": [

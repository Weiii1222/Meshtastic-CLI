        }
      ]
    },
    {
      "id": "L2-CLI-005",
      "module": "\u53ef\u9009\u53d6\u8bc1",
      "source_l2_case": "\u914d\u7f6e\u5feb\u7167 / \u56de\u5f52\u524d\u540e\u5bf9\u6bd4",

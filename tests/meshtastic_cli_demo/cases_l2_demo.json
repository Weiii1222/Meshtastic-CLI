            "lora.modem_preset|modem|LONG|SHORT|MEDIUM|PRESET",
            "lora.override_frequency|override_frequency|frequency|Connected|\\d+",
            "device.role|role|CLIENT|TRACKER|ROUTER|MUTE"
          ],
          "action_summary": "\u6279\u91cf\u8bfb\u53d6\u6d4b\u8bd5\u8bbe\u59071\u901a\u4fe1\u5173\u952e\u914d\u7f6e"
        },
        {
          "name": "\u8bfb\u53d6\u6d4b\u8bd5\u8bbe\u59072\u5173\u952e\u914d\u7f6e",
          "target": "peer",
          "command": [
            "--get",
            "lora.region",
            "--get",
            "lora.modem_preset",
            "--get",
            "lora.override_frequency",
            "--get",
            "device.role"

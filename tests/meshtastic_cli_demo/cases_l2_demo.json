      "module": "\u53ef\u9009\u53d6\u8bc1",
      "source_l2_case": "\u914d\u7f6e\u9879\u53ef\u8bfb\u6027 / \u5b57\u6bb5\u540d\u786e\u8ba4",
      "objective": "\u5217\u51fa\u5f53\u524d CLI/\u56fa\u4ef6\u652f\u6301\u7684\u914d\u7f6e\u5b57\u6bb5\uff0c\u7528\u4e8e\u786e\u8ba4\u53ef\u5199\u914d\u7f6e\u9879\u7684\u51c6\u786e\u5b57\u6bb5\u540d\u3002",
      "test_data": "\u9700\u8981\u6d4b\u8bd5\u8bbe\u59071\u8fde\u63a5\u3002",

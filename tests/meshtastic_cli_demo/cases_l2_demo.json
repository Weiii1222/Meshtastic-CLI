{
  "suite": "Meshtastic CLI \u81ea\u52a8\u5316\u63d0\u6548 Demo",
  "version": "0.8",
  "cases": [
    {
      "id": "L2-CLI-001",
      "module": "\u6d4b\u8bd5\u524d\u68c0\u67e5",
      "source_l2_case": "\u672c\u673a CLI \u73af\u5883\u68c0\u67e5",
      "objective": "\u786e\u8ba4\u672c\u673a Meshtastic CLI \u5df2\u5b89\u88c5\uff0c\u5e76\u80fd\u88ab\u81ea\u52a8\u5316\u6267\u884c\u5668\u8c03\u7528\u3002",
      "test_data": "\u4e0d\u9700\u8981\u8fde\u63a5\u8bbe\u5907\u3002",
      "pass_meaning": "PASS \u53ea\u8bc1\u660e\u672c\u673a CLI \u53ef\u6267\u884c\uff0c\u4e0d\u4ee3\u8868\u8bbe\u5907\u8fde\u63a5\u6216\u901a\u4fe1\u529f\u80fd\u901a\u8fc7\u3002",
      "failure_help": "\u68c0\u67e5\u9879\u76ee .venv \u6216\u7cfb\u7edf PATH \u4e2d\u662f\u5426\u5b58\u5728 meshtastic CLI\u3002",
      "risk": "read_only",
      "steps": [
        {
          "name": "\u8bfb\u53d6 CLI \u7248\u672c",
          "command": [
            "--version"
          ],
          "requires_connection": false,
          "mutating": false,
          "pass_criteria": "CLI \u8fd4\u56de\u7248\u672c\u53f7\u6216 meshtastic \u5173\u952e\u5b57\u3002",
          "expect_stdout_regex": [
            "\\d+\\.\\d+|meshtastic"
          ],
          "action_summary": "\u68c0\u67e5\u672c\u673a meshtastic \u547d\u4ee4\u662f\u5426\u53ef\u8c03\u7528"
        }
      ]
    },
    {
      "id": "L2-CLI-002",
      "module": "\u6d4b\u8bd5\u524d\u68c0\u67e5",
      "source_l2_case": "\u53cc\u8bbe\u5907\u8eab\u4efd / \u901a\u4fe1\u5173\u952e\u914d\u7f6e / NodeDB \u53ef\u89c1\u6027",
      "objective": "\u4e00\u6b21\u5b8c\u6210\u4e24\u53f0\u6d4b\u8bd5\u8bbe\u5907\u7684\u8eab\u4efd\u3001\u901a\u4fe1\u5173\u952e\u914d\u7f6e\u548c NodeDB \u5bf9\u7aef\u53ef\u89c1\u6027\u68c0\u67e5\u3002",
      "test_data": "\u9700\u8981\u6d4b\u8bd5\u8bbe\u59071\u4e32\u53e3\u548c\u6d4b\u8bd5\u8bbe\u59072\u4e32\u53e3\uff1b\u4e24\u4e2a COM \u53e3\u4e0d\u80fd\u76f8\u540c\u3002",
      "pass_meaning": "PASS \u8868\u793a\u4e24\u53f0\u8bbe\u5907\u53ef\u88ab CLI \u63a7\u5236\uff0c\u4e14\u8282\u70b9\u5217\u8868\u80fd\u770b\u5230\u5bf9\u7aef\uff1bNodeDB \u53ef\u89c1\u53ea\u8bc1\u660e\u53d1\u73b0\u8fc7\u8282\u70b9\uff0c\u4e0d\u7b49\u4ef7\u4e8e\u70b9\u5bf9\u70b9\u6d88\u606f ACK\u3002\u82e5 CLI \u8f93\u51fa\u5305\u542b publicKey\uff0c\u62a5\u544a\u4f1a\u5c55\u793a\u8282\u70b9\u516c\u94a5\u3002",
      "failure_help": "\u5982\u679c NodeDB \u6ca1\u770b\u5230\u5bf9\u7aef\uff0c\u5148\u786e\u8ba4\u4e24\u53f0\u8bbe\u5907 region\u3001channel/PSK\u3001modem preset\u3001frequency override \u4e00\u81f4\uff1b\u70b9\u5bf9\u70b9\u8054\u7cfb\u4eba\u5efa\u7acb\u8bf7\u8fd0\u884c\u5de6\u4fa7\u201c\u5efa\u7acb\u70b9\u5bf9\u70b9\u8054\u7cfb\u4eba\u201d\u3002",
      "risk": "read_only",
      "steps": [
        {
          "name": "\u8bfb\u53d6\u6d4b\u8bd5\u8bbe\u59071\u8eab\u4efd",
          "target": "primary",
          "command": [
            "--no-nodes",
            "--info"
          ],
          "requires_connection": true,
          "mutating": false,
          "capture_node_id_as": "primary_node_id",
          "pass_criteria": "CLI \u53ef\u8bfb\u53d6\u8bbe\u5907\u8282\u70b9 ID \u548c\u8bbe\u5907\u540d\uff1b\u4e0d\u8bfb\u53d6\u79c1\u94a5\u3002\u516c\u94a5\u4ece\u540e\u7eed NodeDB \u8f93\u51fa\u4e2d\u63d0\u53d6\u5c55\u793a\u3002",
          "expect_stdout_regex": [
            "Connected to radio"
          ],
          "expect_stdout_regex_any": [
            "myNodeNum|firmwareVersion|hwModel|Owner"
          ],
          "action_summary": "\u786e\u8ba4\u6d4b\u8bd5\u8bbe\u59071 COM \u53e3\u5bf9\u5e94\u7684 Meshtastic \u8282\u70b9\u8eab\u4efd"
        },
        {
          "name": "\u8bfb\u53d6\u6d4b\u8bd5\u8bbe\u59072\u8eab\u4efd",
          "target": "peer",
          "command": [
            "--no-nodes",
            "--info"

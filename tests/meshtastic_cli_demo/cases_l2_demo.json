          "requires_connection": true,
          "requires_peer": true,
          "mutating": false,
          "readback_fields": [
            "lora.region",
            "lora.modem_preset",
            "lora.override_frequency",
            "device.role"
          ],
          "pass_criteria": "\u6d4b\u8bd5\u8bbe\u59072\u53ef\u6279\u91cf\u8bfb\u53d6 Region\u3001Modem Preset\u3001Frequency Override \u548c Device Role\u3002",
          "expect_stdout_regex_any": [
            "lora.region|region|US|EU_868|CN|JP|ANZ|KR|TW|RU|IN",

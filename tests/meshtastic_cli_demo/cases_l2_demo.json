          ],
          "action_summary": "\u7528\u6d4b\u8bd5\u8bbe\u59071 NodeDB \u9a8c\u8bc1\u6d4b\u8bd5\u8bbe\u59072\u662f\u5426\u53ef\u89c1",
          "sensitive_output": true

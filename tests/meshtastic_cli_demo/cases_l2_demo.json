          "action_summary": "\u786e\u8ba4\u6d4b\u8bd5\u8bbe\u59072 COM \u53e3\u5bf9\u5e94\u7684 Meshtastic \u8282\u70b9\u8eab\u4efd"
        },
        {
          "name": "\u8bfb\u53d6\u6d4b\u8bd5\u8bbe\u59071\u5173\u952e\u914d\u7f6e",
          "target": "primary",
          "command": [
            "--get",
            "lora.region",
            "--get",
            "lora.modem_preset",
            "--get",
            "lora.override_frequency",
            "--get",
            "device.role"
          ],
          "requires_connection": true,
          "mutating": false,
          "readback_fields": [
            "lora.region",
            "lora.modem_preset",
            "lora.override_frequency",
            "device.role"
          ],
          "pass_criteria": "\u6d4b\u8bd5\u8bbe\u59071\u53ef\u6279\u91cf\u8bfb\u53d6 Region\u3001Modem Preset\u3001Frequency Override \u548c Device Role\u3002",
          "expect_stdout_regex_any": [
